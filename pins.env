# Pinned inputs. Everything the build downloads is listed here with its SHA-256.
# morphos-team.net publishes no checksums; these were taken on the first fetch
# (12 October 2026) and any later change upstream makes the build fail.

# MorphOS 3.20 SDK
SDK_VERSION=3.20
SDK_DATE=20260529
SDK_URL=https://morphos-team.net/files/sdk-20260529.lha
SDK_SHA256=310dfb888b995e32206c5c3aba409847334a5fee049d13aad27b4af0d518ec77

# Sources that belong to that SDK (GCC, binutils, GMP, MPFR, MPC and the
# MorphOS patches for them)
SDK_SOURCE_URL=https://morphos-team.net/files/src/sdk/sdk-source-20260529.tar.xz
SDK_SOURCE_SHA256=9aafec7377ea816cedad200ad1c7067495d594241cc6f5a41cee98e850b31725

# Components inside the source archive
GCC_VERSION=15.2.0
BINUTILS_VERSION=2.45.1
GMP_VERSION=6.3.0
MPFR_VERSION=4.2.2
MPC_VERSION=1.3.1

# The SDK's libraries carry the note "MorphOS_SDK: 1"; binutils must inject the
# same id, or ld warns about mixed SDK objects.
MORPHOS_SDK_RELEASE_ID=1

# The release this repository describes: the SDK date plus a revision. Raise
# REVISION when the scripts, patches or build container change without a new SDK;
# a new SDK starts again at 1. The tag is v$VERSION.
REVISION=2
VERSION=${SDK_DATE}-r${REVISION}

# Hosts the toolchain is built for. The release workflow matrix lists the same
# hosts; tests/gates.sh fails when the two differ.
HOSTS="linux-x86_64 linux-arm64 macos-arm64"
